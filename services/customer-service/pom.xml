<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.edgareldy</groupId>
        <artifactId>spring-microservices-tutorial</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>customer-service</artifactId>
    <packaging>jar</packaging>

    <name>customer-service</name>
    <description>Customer profile service.</description>

    <dependencies>
        <dependency>
            <groupId>com.edgareldy</groupId>
            <artifactId>common-lib</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Same rationale as auth-service's pom.xml (see feature/observability): no explicit
             <version> needed, both come from spring-boot-dependencies' own BOM imports. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-brave</artifactId>
        </dependency>

        <dependency>
            <groupId>io.zipkin.reporter2</groupId>
            <artifactId>zipkin-reporter-brave</artifactId>
        </dependency>

        <!-- Same rationale as auth-service's pom.xml (see feature/observability):
             without this, BraveAutoConfiguration/ZipkinWithBraveTracingAutoConfiguration
             never run and the two dependencies above silently do nothing. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing-brave</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>

        <!-- Without this, eureka.client.service-url.defaultZone is inert: the
             service pulls its config from config-server but never actually
             registers with discovery-server (lesson from feature/auth-service). -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Spring Boot 4.x split Flyway's autoconfiguration glue out of the old
             monolithic spring-boot-autoconfigure into this dedicated module.
             flyway-core/flyway-database-postgresql alone (above) no longer run
             V1__init_schema.sql at all without it: this must be a real
             (compile-scope) dependency, not test-only, or the deployed service
             silently never migrates its schema (lesson from feature/auth-service
             and feature/catalog-service). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Versions for jjwt/springdoc are pinned once in the root pom.xml's
             dependencyManagement, not here. customer-service only ever parses a
             JWT issued by auth-service, it never signs one, but jjwt-api is
             still needed at compile time to call Jwts.parser(). -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <!-- Version pinned once in the root pom.xml's dependencyManagement, not here. -->
        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Boot 4.x split @DataJpaTest and its slice autoconfiguration out of
             spring-boot-test-autoconfigure into their own per-feature test starter, unlike
             3.x where spring-boot-starter-test alone was enough. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Same 4.x split as spring-boot-starter-data-jpa-test above, but for the MVC test
             slice: @WebMvcTest/@AutoConfigureMockMvc moved out of spring-boot-test-autoconfigure
             into this dedicated starter. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers 2.x renamed the module from "postgresql" to "testcontainers-postgresql". -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- No explicit <version>: resolved from spring-cloud-dependencies (imported as a BOM
             in the root pom.xml), which in turn imports spring-cloud-contract-dependencies.
             Generates, at test-compile time, one JUnit test per contract under
             src/test/resources/contracts extending CustomerContractBase, and (on `install`)
             publishes a -stubs jar consumers can pull in via spring-cloud-contract-stub-runner
             instead of hand-writing WireMock stubs. -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-contract-verifier</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Order matters: lombok-mapstruct-binding must be resolved before
                         mapstruct-processor so MapStruct sees Lombok-generated
                         getters/setters/builders when generating mapper implementations. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- Unlike spring-cloud-starter-contract-verifier above, this plugin's version is
                 NOT resolved from the imported spring-cloud-dependencies BOM: that BOM only
                 manages <dependencies>, never build <plugins>, and Maven does not inherit
                 properties (spring-cloud-contract.version = 5.0.3 in this train) from an
                 imported POM into this module's own property table. Pinned explicitly here
                 instead of reusing ${spring-cloud.version} (2025.1.2): spring-cloud-contract
                 ships its own, distinct release train, resolved by cross-checking the value
                 actually declared in spring-cloud-dependencies:2025.1.2's dependencyManagement. -->
            <plugin>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-contract-maven-plugin</artifactId>
                <version>5.0.3</version>
                <extensions>true</extensions>
                <configuration>
                    <baseClassForTests>com.edgareldy.springmicroservicestutorial.customerservice.contract.CustomerContractBase</baseClassForTests>
                    <!-- GenerateTestsMojo's "up to date" fast path (default true) skips
                         MavenProject#addTestCompileSourceRoot(...) entirely whenever it
                         decides nothing changed, including on a plain first build in some
                         cases observed here: the generated test class then silently never
                         gets compiled or run, with no build failure to notice it. Forcing
                         full regeneration every build sidesteps that; regenerating one
                         contract's test class is cheap enough that the incremental skip
                         buys nothing worth this footgun. -->
                    <incrementalContractTests>false</incrementalContractTests>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
