<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.edgareldy</groupId>
        <artifactId>spring-microservices-tutorial</artifactId>
        <version>${revision}</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>

    <artifactId>catalog-service</artifactId>
    <packaging>jar</packaging>

    <name>catalog-service</name>
    <description>Categories/products service.</description>

    <dependencies>
        <dependency>
            <groupId>com.edgareldy</groupId>
            <artifactId>common-lib</artifactId>
            <version>${revision}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Same rationale as auth-service's pom.xml (see feature/observability): no explicit
             <version> needed, both come from spring-boot-dependencies' own BOM imports. -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-brave</artifactId>
        </dependency>

        <dependency>
            <groupId>io.zipkin.reporter2</groupId>
            <artifactId>zipkin-reporter-brave</artifactId>
        </dependency>

        <!-- Same rationale as auth-service's pom.xml (see feature/observability):
             without this, BraveAutoConfiguration/ZipkinWithBraveTracingAutoConfiguration
             never run and the two dependencies above silently do nothing. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-micrometer-tracing-brave</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-config</artifactId>
        </dependency>

        <!-- Without this, eureka.client.service-url.defaultZone is inert: the
             service pulls its config from config-server but never actually
             registers with discovery-server (lesson from feature/auth-service). -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>

        <!-- Spring Boot 4.x split Flyway's autoconfiguration glue out of the old
             monolithic spring-boot-autoconfigure into this dedicated module.
             flyway-core/flyway-database-postgresql alone (above) no longer run
             V1__init_schema.sql at all without it: this must be a real
             (compile-scope) dependency, not test-only, or the deployed service
             silently never migrates its schema (lesson from feature/auth-service). -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-flyway</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!-- Versions for jjwt/springdoc are pinned once in the root pom.xml's
             dependencyManagement, not here. catalog-service only ever parses a
             JWT issued by auth-service, it never signs one, but jjwt-api is
             still needed at compile time to call Jwts.parser(). -->
        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-api</artifactId>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-impl</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>io.jsonwebtoken</groupId>
            <artifactId>jjwt-jackson</artifactId>
            <scope>runtime</scope>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.mapstruct</groupId>
            <artifactId>mapstruct</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Spring Boot 4.x split @DataJpaTest and its slice autoconfiguration out of
             spring-boot-test-autoconfigure into their own per-feature test starter, unlike
             3.x where spring-boot-starter-test alone was enough. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Same 4.x split as spring-boot-starter-data-jpa-test above, but for the MVC test
             slice: @WebMvcTest/@AutoConfigureMockMvc moved out of spring-boot-test-autoconfigure
             into this dedicated starter. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Testcontainers 2.x renamed the module from "postgresql" to "testcontainers-postgresql". -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- feature/contract-testing: generates one JUnit test per contract under
             src/test/resources/contracts against ProductContractBase, and (via the
             spring-cloud-contract-maven-plugin below) packages those same contracts into
             a -stubs jar that order-service's consumer-side stub runner installs and
             replays. No explicit <version> needed: spring-cloud-dependencies (imported
             in the root pom.xml) already imports spring-cloud-contract-dependencies,
             which manages this artifact's version. -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-contract-verifier</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Order matters: lombok-mapstruct-binding must be resolved before
                         mapstruct-processor so MapStruct sees Lombok-generated
                         getters/setters/builders when generating mapper implementations. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok-mapstruct-binding</artifactId>
                            <version>${lombok-mapstruct-binding.version}</version>
                        </path>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>

            <!-- feature/contract-testing: generates a JUnit test per contract under
                 src/test/resources/contracts, running it against baseClassForTests below,
                 and attaches a "-stubs" jar built from those same contracts to this
                 module's install/deploy, for order-service's consumer-side stub runner to
                 consume.

                 Deliberately NOT <extensions>true</extensions>: that flag makes Maven load
                 this plugin as a *core* extension during full reactor graph construction,
                 for every build in this repo, even one that only targets an unrelated
                 module (e.g. "mvn -pl common-lib -am test") and never touches
                 catalog-service at all, since Maven still reads every module's POM (and
                 its declared extensions) to compute that graph before filtering by -pl.
                 This plugin's own dependency tree brings in the ancient
                 org.apache.maven:maven-project:2.2.1 API (and its own old transitive
                 httpclient), and loading that into Maven's shared core classloader
                 alongside Maven's own httpclient usage produced a genuine, reproducible
                 ClassCastException (BasicAuthCache/AuthCache loaded by two different
                 ClassRealms) on a fresh CI runner, confirmed by clearing this plugin's
                 artifacts from .m2 and re-running common-lib's own CI job, which does not
                 build this module at all. Binding the three goals below explicitly via
                 <executions> instead achieves the same result (each goal's own default
                 phase, generateTests/convert/generateStubs, comes straight from this
                 plugin's own plugin.xml, unaffected by the extensions flag) without ever
                 loading this plugin outside a build that actually includes this module.

                 <version> is pinned explicitly rather than left to
                 spring-cloud-dependencies: that BOM only manages *dependency* versions
                 (see spring-cloud-starter-contract-verifier above), never build *plugin*
                 versions, and there is no "2025.1.2"/"Oakwood" release of this Maven
                 plugin artifact regardless (Spring Cloud Contract keeps its own release
                 numbering, decoupled from the umbrella train name). 5.0.3 is the exact
                 version spring-cloud-dependencies:2025.1.2 itself pulls in for
                 spring-cloud-contract-dependencies (its <spring-cloud-contract.version>
                 property), confirmed against Maven Central, so it is pinned here to stay
                 consistent with the dependency version actually in use. -->
            <plugin>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-contract-maven-plugin</artifactId>
                <version>5.0.3</version>
                <configuration>
                    <baseClassForTests>com.edgareldy.springmicroservicestutorial.catalogservice.contract.ProductContractBase</baseClassForTests>
                    <!-- Default true: the plugin's ChangeDetector skips registering the
                         generated test as a compiled source root when it thinks nothing
                         changed, silently never compiling or running it (no build failure,
                         no warning). Forces the goal to always regenerate and register it. -->
                    <incrementalContractTests>false</incrementalContractTests>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>generateTests</goal>
                            <goal>convert</goal>
                            <goal>generateStubs</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
