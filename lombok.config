config.stopBubbling = true

# Without this, @RequiredArgsConstructor/@AllArgsConstructor silently drop
# @Lazy from a field when generating the constructor parameter for it: Lombok
# only copies a small built-in whitelist of annotations onto generated
# constructor parameters, and @Lazy is not in it. OrderServiceImpl relies on
# @Lazy OrderServiceImpl self (self-injection through this bean's own Spring
# proxy, see that class' own Javadoc) staying lazy specifically to avoid an
# eager circular-dependency failure at startup; without this line, Spring
# sees a genuinely eager self-referential constructor dependency and refuses
# to start ("dependencies of some of the beans... form a cycle").
lombok.copyableAnnotations += org.springframework.context.annotation.Lazy
